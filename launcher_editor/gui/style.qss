/* Launcher Config Editor - default light theme */

QMainWindow, QDialog {
    background: #f4f6f8;
}

QToolBar {
    background: #eef1f5;
    border: none;
    padding: 4px;
    spacing: 4px;
}

QToolButton, QPushButton {
    padding: 4px 8px;
    border-radius: 4px;
}

QToolButton:hover, QPushButton:hover {
    background: #e2e8f0;
}

QMenuBar {
    background: #eef1f5;
}

QTabWidget::pane {
    border-top: 1px solid #d0d7de;
    background: #ffffff;
}

QTabBar::tab {
    padding: 6px 14px;
    background: #e6e9ee;
    border: 1px solid #d0d7de;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ffffff;
    font-weight: 600;
}

QListWidget {
    background: #ffffff;
    border: 1px solid #d0d7de;
    outline: none;
}

QListWidget::item {
    padding: 5px 6px;
    border-bottom: 1px solid #f0f2f5;
}

QListWidget::item:selected {
    background: #dbe6fb;
    color: #10253f;
}

QStatusBar {
    background: #eef1f5;
}
